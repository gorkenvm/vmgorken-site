---
import { hero, site } from "../data/content";
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <!-- Animasyonlu nokta dokulu arka plan -->
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-content fade-up">
    <img
      src="/photo.jpg"
      alt={site.name}
      class="hero-photo"
      width="120"
      height="120"
      loading="eager"
    />

    <div class="hero-tag">{hero.tag}</div>

    <h1 class="hero-name">
      {hero.name}<br />{hero.surname}
    </h1>

    <p class="hero-title">{hero.title}</p>

    <p class="hero-bio">{hero.bio}</p>

    <div class="hero-chips">
      {hero.chips.map((c) => <span class="chip">{c}</span>)}
    </div>

    <div class="hero-links">
      <a href={hero.ctas.primary.href} class="btn btn--primary">
        {hero.ctas.primary.label}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href={hero.ctas.secondary.href} class="btn btn--ghost" download>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {hero.ctas.secondary.label}
      </a>
      <a href={site.github} target="_blank" rel="noopener" class="btn btn--ghost">
        GitHub
      </a>
    </div>

    <div class="hero-location">
      <span class="status-dot"></span>
      DORTMUND, ALMANYA &nbsp;·&nbsp; AVRUPA GENELİNE AÇIK
    </div>
  </div>

  <!-- Aşağı kaydır göstergesi -->
  <a href="#metrics" class="scroll-cue" aria-label="Aşağı kaydır">
    <span>scroll</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <polyline points="19 12 12 19 5 12"></polyline>
    </svg>
  </a>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 60px 100px;
    overflow: hidden;
    position: relative;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 75% 40%, rgba(91, 141, 246, 0.10) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 25% 75%, rgba(177, 129, 246, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(91, 141, 246, 0.08) 1px,
      transparent 1px
    );
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
    pointer-events: none;
    opacity: 0.6;
  }

  .hero-content {
    max-width: 640px;
    position: relative;
    z-index: 1;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-tag::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  .hero-name {
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 18px;
    color: var(--text);
  }

  .hero-title {
    font-size: 19px;
    font-weight: 300;
    color: var(--text-soft);
    margin-bottom: 28px;
    letter-spacing: -0.005em;
  }

  .hero-bio {
    font-size: 15px;
    color: var(--text-soft);
    line-height: 1.75;
    max-width: 540px;
    margin-bottom: 36px;
    border-left: 2px solid var(--border);
    padding-left: 18px;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 48px;
  }

  .hero-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 2px solid var(--border);
    margin-bottom: 28px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-dim);
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgba(97, 216, 137, 0.5);
    animation: pulseDot 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulseDot {
    0% { box-shadow: 0 0 0 0 rgba(97, 216, 137, 0.5); }
    70% { box-shadow: 0 0 0 10px rgba(97, 216, 137, 0); }
    100% { box-shadow: 0 0 0 0 rgba(97, 216, 137, 0); }
  }

  .scroll-cue {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-dim);
    text-decoration: none;
    transition: color 0.2s;
    animation: bobbing 2.4s ease-in-out infinite;
  }
  .scroll-cue:hover { color: var(--accent); }

  @keyframes bobbing {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (max-width: 860px) {
    .hero { padding: 64px 24px 120px; min-height: auto; }
    .hero-photo { width: 96px; height: 96px; }
    .scroll-cue { display: none; }
  }
</style>
