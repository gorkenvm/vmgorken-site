---
import { hero, site } from "../data/content";
---

<section class="hero" id="hero">

  <div class="blobs" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
  </div>

  <div class="hero-grid" aria-hidden="true"></div>

  <img
    src="/photo.jpg"
    alt={site.name}
    class="hero-photo"
    width="60"
    height="60"
    loading="eager"
  />

  <h1 class="hero-name" id="scramble-name" aria-label={site.name}>&nbsp;</h1>

  <div class="scroll-cue">
    <span class="scroll-label">SCROLL TO EXPLORE</span>
    <div class="scroll-line"></div>
  </div>

</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 60px;
    overflow: hidden;
    position: relative;
    background: #08090d;
  }

  /* Blobs */
  .blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
  }
  .blob-1 { width:650px; height:650px; background:#0e7490; top:-220px; left:-180px; opacity:.18; animation:b1 11s ease-in-out infinite alternate; }
  .blob-2 { width:550px; height:550px; background:#5b21b6; bottom:-120px; right:-80px; opacity:.16; animation:b2 15s ease-in-out infinite alternate; }
  .blob-3 { width:380px; height:380px; background:#065f46; top:45%; left:55%; opacity:.13; animation:b3 9s ease-in-out infinite alternate; }
  .blob-4 { width:300px; height:300px; background:#1e3a8a; top:15%; right:20%; opacity:.14; animation:b4 13s ease-in-out infinite alternate; }

  @keyframes b1 { from{transform:translate(0,0) scale(1)} to{transform:translate(140px,90px) scale(1.18)} }
  @keyframes b2 { from{transform:translate(0,0) scale(1)} to{transform:translate(-100px,-70px) scale(1.12)} }
  @keyframes b3 { from{transform:translate(0,0) scale(1)} to{transform:translate(70px,-100px) scale(0.88)} }
  @keyframes b4 { from{transform:translate(0,0) scale(1)} to{transform:translate(-60px,80px) scale(1.15)} }

  /* Grid */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(ellipse 100% 80% at 50% 50%, #000 10%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 100% 80% at 50% 50%, #000 10%, transparent 80%);
    pointer-events: none;
  }

  /* Photo */
  .hero-photo {
    position: absolute;
    top: 40px;
    left: 60px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 1.5px solid rgba(255,255,255,0.12);
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    z-index: 2;
  }

  /* Title */
  .hero-name {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.0;
    color: #fff;
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
    z-index: 2;
    width: 100%;
    text-align: center;
    font-size: clamp(52px, 9vw, 120px);
    min-height: 1.05em;
  }

  /* Blinking cursor */
  .hero-name::after {
    content: '|';
    margin-left: 3px;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    z-index: 2;
  }
  .scroll-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    white-space: nowrap;
  }
  .scroll-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.35), transparent);
    transform-origin: top;
    animation: lineGrow 1.8s ease-in-out infinite;
  }
  @keyframes lineGrow {
    0%   { transform: scaleY(0); opacity: 1; }
    60%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (max-width: 860px) {
    .hero { padding: 0 24px; }
    .hero-photo { left: 24px; top: 28px; width: 48px; height: 48px; }
  }
</style>

<script>
  const TEXTS     = ["VEYSEL MURAT GORKEN", "DATA SCIENTIST & AI ENGINEER"];
  const GLITCH    = "!@#$%^&*_+<>?~[]{}";
  const STEP_MS   = 28;
  const GLITCH_MS = 25;
  const HOLD_MS   = 2400;
  const PAUSE_MS  = 350;

  const el = document.getElementById("scramble-name") as HTMLElement;

  const sleep     = (ms: number) => new Promise<void>(r => setTimeout(r, ms));
  const rndGlitch = () => GLITCH[Math.floor(Math.random() * GLITCH.length)];

  function calcFontSize(text: string): number {
    const availW   = (el.parentElement as HTMLElement).offsetWidth;
    const savedFs  = el.style.fontSize;
    const savedTxt = el.textContent;

    let lo = 16, hi = 500;
    while (hi - lo > 1) {
      const mid = (lo + hi) >> 1;
      el.style.fontSize = mid + "px";
      el.textContent    = text;
      if (el.scrollWidth <= availW) lo = mid; else hi = mid;
    }
    el.style.fontSize = savedFs;
    el.textContent    = savedTxt;
    return lo;
  }

  const sizes = TEXTS.map(calcFontSize);
  let idx = 0;

  // Render a centered window of `len` chars from `full`,
  // optionally glitching the two leading/trailing edge chars.
  function render(full: string, len: number, glitchEdges: boolean) {
    if (len <= 0) { el.textContent = " "; return; }
    const N = full.length;
    const start = Math.floor((N - len) / 2);
    const chars = full.slice(start, start + len).split("");
    if (glitchEdges) {
      chars[0] = rndGlitch();
      chars[chars.length - 1] = rndGlitch();
    }
    el.textContent = chars.join("");
  }

  async function run() {
    while (true) {
      const full = TEXTS[idx];
      const N = full.length;
      el.style.fontSize = sizes[idx] + "px";

      // OPEN — grow from center outward to both sides
      for (let len = 1; len <= N; len += 2) {
        render(full, len, true);          // glitch the new edges
        await sleep(GLITCH_MS);
        render(full, len, false);         // settle to real chars
        await sleep(STEP_MS);
      }
      render(full, N, false);

      await sleep(HOLD_MS);

      // CLOSE — converge from both ends toward the center
      for (let len = N; len > 0; len -= 2) {
        render(full, len, true);          // glitch the dying edges
        await sleep(GLITCH_MS);
        render(full, len - 2, false);     // shrink toward center
        await sleep(STEP_MS);
      }
      el.textContent = " ";

      idx = (idx + 1) % TEXTS.length;
      await sleep(PAUSE_MS);
    }
  }

  run();

  window.addEventListener("resize", () => {
    TEXTS.forEach((t, i) => { sizes[i] = calcFontSize(t); });
    el.style.fontSize = sizes[idx] + "px";
  });
</script>
