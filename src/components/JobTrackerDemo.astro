---
import { jobTrackerMock } from "../data/content";

const statusColorMap: Record<string, string> = {
  blue: "var(--accent)",
  green: "var(--green)",
  purple: "var(--purple)",
  yellow: "var(--yellow)",
  gray: "var(--muted)",
};

const counts = {
  total: jobTrackerMock.length,
  interview: jobTrackerMock.filter((j) =>
    ["Mülakat", "Teknik Görev"].includes(j.status)
  ).length,
  positive: jobTrackerMock.filter((j) => j.status === "Olumlu Geri Bildirim").length,
  applied: jobTrackerMock.filter((j) => j.status === "Başvuruldu").length,
};
---

<div class="demo-wrap reveal" id="jobtracker-demo">
  <div class="demo-head">
    <div>
      <div class="demo-eyebrow">Yaşayan Demo · Mock Data</div>
      <h3 class="demo-title">JobTracker — kendi iş arama hattım</h3>
      <p class="demo-desc">
        JobTracker'ı kendi iş başvurularımı yönetmek için yazdım. Aşağıda mock
        veriyle çalışan canlı bir önizleme — filtrele, sırala, kart açıver.
      </p>
    </div>
    <a href="https://github.com/gorkenvm" class="btn btn--ghost" target="_blank" rel="noopener">
      Kaynak Kodu →
    </a>
  </div>

  <!-- Stat satırı -->
  <div class="demo-stats">
    <div><span class="demo-stat-n">{counts.total}</span><span class="demo-stat-l">Toplam başvuru</span></div>
    <div><span class="demo-stat-n">{counts.interview}</span><span class="demo-stat-l">Mülakat aşamasında</span></div>
    <div><span class="demo-stat-n">{counts.positive}</span><span class="demo-stat-l">Olumlu</span></div>
    <div><span class="demo-stat-n">{counts.applied}</span><span class="demo-stat-l">Bekleyen</span></div>
  </div>

  <!-- Filtre çubuğu -->
  <div class="demo-filters">
    <button class="filter-btn active" data-filter="all">Hepsi</button>
    <button class="filter-btn" data-filter="Mülakat">Mülakat</button>
    <button class="filter-btn" data-filter="Teknik Görev">Teknik Görev</button>
    <button class="filter-btn" data-filter="Olumlu Geri Bildirim">Olumlu</button>
    <button class="filter-btn" data-filter="Başvuruldu">Başvuruldu</button>
    <button class="filter-btn" data-filter="Beklemede">Beklemede</button>
  </div>

  <!-- Tablo -->
  <div class="demo-table">
    <div class="row row-head">
      <div>Şirket</div>
      <div>Pozisyon</div>
      <div>Lokasyon</div>
      <div>Durum</div>
      <div>Başvuru</div>
    </div>
    {
      jobTrackerMock.map((job) => (
        <div class="row" data-status={job.status}>
          <div class="cell-company">{job.company}</div>
          <div class="cell-role">{job.role}</div>
          <div class="cell-loc">{job.location}</div>
          <div>
            <span
              class="status-pill"
              style={`--pill-color: ${statusColorMap[job.statusColor]};`}
            >
              {job.status}
            </span>
          </div>
          <div class="cell-date">{job.applied}</div>
        </div>
      ))
    }
  </div>

  <p class="demo-note">
    Not: Bu veri demonstratif amaçlı oluşturulmuştur. Gerçek uygulamada PostgreSQL backend, çoklu LLM ile cover letter üretimi ve PDF/DOCX export mevcut.
  </p>
</div>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const rows = document.querySelectorAll<HTMLElement>("#jobtracker-demo .row:not(.row-head)");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const f = btn.dataset.filter;
      rows.forEach((r) => {
        const match = f === "all" || r.dataset.status === f;
        r.style.display = match ? "" : "none";
      });
    });
  });
</script>

<style>
  .demo-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-top: 16px;
  }

  .demo-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .demo-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple);
    margin-bottom: 10px;
  }

  .demo-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .demo-desc {
    font-size: 13.5px;
    color: var(--text-soft);
    line-height: 1.65;
    max-width: 540px;
  }

  .demo-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .demo-stats > div {
    background: var(--bg-2);
    padding: 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .demo-stat-n {
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--accent);
    font-weight: 500;
  }

  .demo-stat-l {
    font-size: 11.5px;
    color: var(--muted);
  }

  .demo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-soft);
    background: transparent;
    letter-spacing: 0.02em;
    transition: var(--transition);
  }
  .filter-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .filter-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .demo-table {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-2);
  }

  .row {
    display: grid;
    grid-template-columns: 1.4fr 1.6fr 1fr 1.1fr 0.9fr;
    gap: 16px;
    padding: 14px 18px;
    align-items: center;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    transition: background 0.2s;
  }
  .row:last-child { border-bottom: none; }
  .row:not(.row-head):hover { background: var(--surface); }

  .row-head {
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding: 12px 18px;
  }

  .cell-company { color: var(--text); font-weight: 500; }
  .cell-role { color: var(--text-soft); }
  .cell-loc { color: var(--muted); font-size: 12.5px; }
  .cell-date { font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }

  .status-pill {
    display: inline-block;
    font-size: 10.5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pill-color, var(--accent)) 14%, transparent);
    color: var(--pill-color, var(--accent));
    border: 1px solid color-mix(in srgb, var(--pill-color, var(--accent)) 30%, transparent);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .demo-note {
    font-size: 11.5px;
    color: var(--muted-dim);
    margin-top: 16px;
    line-height: 1.6;
    font-style: italic;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      font-size: 12.5px;
    }
    .row-head { display: none; }
    .row:not(.row-head) > div {
      padding: 2px 0;
    }
    .cell-loc, .cell-date { font-size: 11.5px; }
  }
</style>
