---
import { site } from "../data/content";
---

<section class="section contact-section" id="contact">
  <div class="section-inner">
    <div class="contact-body reveal">
      <div class="section-eyebrow">İletişim</div>
      <h2 class="section-title">Ulaşın</h2>

      <a href={`mailto:${site.email}`} class="email-link">{site.email}</a>
    </div>

    <footer class="site-footer">
      <div>© 2026 {site.name} · {site.location}</div>
      <div class="footer-meta">
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <span>·</span>
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <span>·</span>
        <a href={`mailto:${site.email}`}>E-posta</a>
      </div>
    </footer>
  </div>
</section>

<style>
  .contact-section {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }

  .contact-body {
    margin-bottom: 80px;
  }

  .email-link {
    display: inline-block;
    margin-top: 20px;
    font-size: 20px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .email-link:hover { color: var(--text); }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .footer-meta {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .footer-meta a {
    color: var(--text-soft);
    transition: color 0.2s;
  }
  .footer-meta a:hover { color: var(--accent); }
</style>
