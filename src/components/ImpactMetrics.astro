---
import { metrics } from "../data/content";
---

<section class="section metrics-section" id="metrics">
  <div class="section-inner">
    <div class="reveal">
      <div class="section-eyebrow">Impact</div>
      <h2 class="section-title">Rakamlarla iz bırakan AI sistemleri</h2>
      <p class="section-lead">
        Lab demolarının ötesinde — şehir altyapısında, üretim ortamında, gerçek
        kullanıcılarla doğrulanmış sonuçlar.
      </p>
    </div>

    <div class="metrics-grid">
      {
        metrics.map((m, i) => (
          <div
            class="metric-card reveal"
            style={`transition-delay: ${i * 80}ms;`}
            data-value={m.value}
            data-suffix={m.suffix}
            data-decimals={m.decimals ?? 0}
          >
            <div class="metric-value">
              <span class="metric-num">0</span>
              <span class="metric-suffix">{m.suffix}</span>
            </div>
            <div class="metric-label">{m.label}</div>
            <div class="metric-detail">{m.detail}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Counter animasyonu — viewport'a girdiğinde başlar
  function animateCounter(el: HTMLElement) {
    const target = parseFloat(el.dataset.value || "0");
    const decimals = parseInt(el.dataset.decimals || "0", 10);
    const numEl = el.querySelector(".metric-num") as HTMLElement;
    if (!numEl) return;

    const duration = 1400;
    const start = performance.now();

    function tick(now: number) {
      const t = Math.min((now - start) / duration, 1);
      // ease-out cubic
      const eased = 1 - Math.pow(1 - t, 3);
      const current = target * eased;
      numEl.textContent = current.toFixed(decimals);
      if (t < 1) requestAnimationFrame(tick);
      else numEl.textContent = target.toFixed(decimals);
    }
    requestAnimationFrame(tick);
  }

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animateCounter(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll(".metric-card").forEach((el) => io.observe(el));
</script>

<style>
  .metrics-section {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .metric-card {
    background: var(--surface);
    padding: 28px 26px;
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .metric-card:hover {
    background: var(--surface-2);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 14px;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .metric-suffix {
    font-size: 20px;
    color: var(--accent);
    opacity: 0.85;
    font-weight: 400;
  }

  .metric-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
    letter-spacing: -0.005em;
  }

  .metric-detail {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 540px) {
    .metric-value { font-size: 32px; }
  }
</style>
