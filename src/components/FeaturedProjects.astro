---
import { projects } from "../data/content";
import JobTrackerDemo from "./JobTrackerDemo.astro";
---

<section class="section projects-section" id="projects">
  <div class="section-inner">
    <div class="reveal">
      <div class="section-eyebrow">Seçili Projeler</div>
      <h2 class="section-title">
        Hatları kuran, ajanları konuşturan, sistemleri çalıştıran
      </h2>
      <p class="section-lead">
        Birden fazla LLM sağlayıcı, vektör veritabanı ve agent mimarisiyle
        kurgulanmış üç vitrin. Hepsi GitHub'da açık kaynak.
      </p>
    </div>

    <div class="projects-grid">
      {
        projects.map((p, i) => (
          <article
            class={`project-card reveal accent-${p.accent}`}
            style={`transition-delay: ${i * 100}ms;`}
          >
            <div class="project-header">
              <div class="project-mark" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
              <h3 class="project-name">{p.name}</h3>
            </div>

            <p class="project-tagline">{p.tagline}</p>
            <p class="project-desc">{p.description}</p>

            <div class="project-stack">
              {p.stack.map((s) => <span class="chip">{s}</span>)}
            </div>

            <div class="project-footer">
              <span class="project-impact">{p.impact}</span>
              <a
                href={p.github}
                target="_blank"
                rel="noopener"
                class="project-link"
              >
                GitHub
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17L17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </div>

            {p.hasDemo && (
              <div class="project-demo-hint">
                <span>↓ Mini demo aşağıda</span>
              </div>
            )}
          </article>
        ))
      }
    </div>

    <!-- JobTracker gömülü mini-demo -->
    <JobTrackerDemo />
  </div>
</section>

<style>
  .projects-section {
    padding-bottom: 64px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 80px;
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 26px 24px;
    position: relative;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-color, var(--accent)), transparent);
    opacity: 0.4;
    transition: opacity 0.3s var(--ease);
  }

  .project-card.accent-blue { --accent-color: var(--accent); }
  .project-card.accent-purple { --accent-color: var(--purple); }
  .project-card.accent-green { --accent-color: var(--green); }

  .project-card:hover {
    border-color: var(--accent-color, var(--accent));
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }
  .project-card:hover::before { opacity: 1; }

  .project-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .project-mark {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--accent-color, var(--accent));
    padding: 3px 7px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .project-name {
    font-size: 19px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .project-tagline {
    font-size: 13.5px;
    color: var(--accent-color, var(--accent));
    font-weight: 500;
    margin-top: -4px;
  }

  .project-desc {
    font-size: 13.5px;
    color: var(--text-soft);
    line-height: 1.65;
    flex: 1;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-stack .chip {
    font-size: 10.5px;
    padding: 4px 9px;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .project-impact {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--text-soft);
    transition: color 0.2s;
  }
  .project-link:hover { color: var(--accent-color, var(--accent)); }

  .project-demo-hint {
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    text-align: center;
    letter-spacing: 0.04em;
  }
</style>
